# Environment variables for Vintajoriginal

# Server
PORT=3000
NODE_ENV=development
HOST=127.0.0.1

# Keep empty for same-origin storefront/API. In production, list only trusted origins.
CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vintajoriginal
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# JWT (if used, but we prefer sessions)
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=1h

# Session (not active yet; use a generated secret before implementing sessions)
SESSION_SECRET=your_session_secret_here
SESSION_NAME=sid

# Security
BCRYPT_SALT_ROUNDS=12

# Email (for development, use ethereal or similar)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_user
EMAIL_PASS=your_ethereal_password

# Stripe Checkout (server-side only; never expose secret keys to frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=azn
# Standard shipping within Azerbaijan, in qəpik (4.99 AZN).
SHIPPING_STANDARD_AZN_QAPIK=499
# Express delivery is not currently offered.
SHIPPING_EXPRESS_AZN_QAPIK=
CHECKOUT_TAX_RATE_BPS=
CHECKOUT_TAX_INCLUSIVE=
CHECKOUT_LIVE_ENABLED=false

# Shipping provider (to be set after selection)
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_KEY=

# Base URL
BASE_URL=http://localhost:3000
